{
  "tool_count": 25,
  "tools": [
    {
      "description": "Append a typed event to the agent's persistent memory log.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "description": "Actor that emitted the event",
            "type": "string"
          },
          "event_type": {
            "description": "Event type, e.g. 'goal.created'",
            "type": "string"
          },
          "payload": {
            "description": "Structured payload",
            "type": "object"
          },
          "session_id": {
            "description": "Session ID for multi-agent sharding",
            "type": "string"
          },
          "thread": {
            "description": "Logical thread / session ID (legacy, use session_id)",
            "type": "string"
          }
        },
        "required": [
          "event_type",
          "actor",
          "payload"
        ],
        "type": "object"
      },
      "name": "memory_append"
    },
    {
      "description": "Query the temporal knowledge graph for relevant context.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "description": "Opaque cursor from a prior paged memory_query call",
            "type": "string"
          },
          "limit": {
            "default": 10,
            "description": "Max results",
            "type": "integer"
          },
          "paged": {
            "description": "Return contexts with pagination metadata",
            "type": "boolean"
          },
          "query": {
            "description": "Natural language query",
            "type": "string"
          },
          "session_id": {
            "description": "Session ID for scoped retrieval",
            "type": "string"
          },
          "session_ids": {
            "description": "Local-only explicit cross-session query scope",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "temporal_filter": {
            "description": "ISO-8601 point-in-time filter",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "memory_query"
    },
