        "type": "object",
        "required": [
          "mission_id",
          "decisions"
        ],
        "properties": {
          "mission_id": {
            "type": "string"
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "actor": {
            "type": "string",
            "default": "coordinator"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "coordination_review_finding",
