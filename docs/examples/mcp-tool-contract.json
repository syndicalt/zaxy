        "type": "object",
        "required": [
          "mission_id",
          "summary"
        ],
        "properties": {
          "mission_id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "next_steps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actor": {
            "type": "string",
            "default": "coordinator"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "coordination_record_synthesis_artifact",
      "description": "Persist a Coordinate synthesis proof packet for a mission-scoped Memory Checkout. Handoff-scoped packets require handoff_id and return handoff_event_ref with the cited handoff seq/hash.",
      "input_schema": {
        "type": "object",
        "required": [
          "mission_id",
          "checkout"
        ],
        "properties": {
          "mission_id": {
            "type": "string"
          },
          "checkout": {
            "type": "object",
            "description": "Memory Checkout payload scoped to the same mission_id"
          },
          "decision_scope": {
            "type": "string",
            "default": "brief"
          },
          "handoff_id": {
            "type": "string",
