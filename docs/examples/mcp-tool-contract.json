            "type": "string"
          },
          "status": {
            "enum": [
              "accepted",
              "rejected",
              "deferred",
              "conflicted"
            ],
            "type": "string"
          }
        },
        "required": [
          "mission_id",
          "finding_id",
          "status"
        ],
        "type": "object"
      },
      "name": "coordination_review_finding"
    },
    {
      "description": "Promote an accepted finding into the parent mission history.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "default": "coordinator",
            "type": "string"
          },
          "finding_id": {
            "type": "string"
          },
          "mission_id": {
            "type": "string"
          }
        },
        "required": [
          "mission_id",
          "finding_id"
        ],
        "type": "object"
      },
      "name": "coordination_promote"
    },
    {
      "description": "Create a final coordination handoff event for a mission.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "default": "coordinator",
            "type": "string"
          },
          "mission_id": {
            "type": "string"
          },
          "next_steps": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "risks": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "mission_id",
          "summary"
        ],
        "type": "object"
      },
      "name": "coordination_handoff"
    },
    {
      "description": "Persist a Coordinate synthesis proof packet for a mission-scoped Memory Checkout. Handoff-scoped packets require handoff_id and return handoff_event_ref with the cited handoff seq/hash.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "default": "coordinator",
            "type": "string"
          },
          "candidate": {
            "description": "Optional selected answer candidate from checkout diagnostics",
            "type": "object"
          },
          "checkout": {
            "description": "Memory Checkout payload scoped to the same mission_id",
            "type": "object"
          },
          "decision_scope": {
            "default": "brief",
            "type": "string"
          },
          "handoff_id": {
            "description": "Required when decision_scope is handoff; binds proof to a handoff event.",
            "type": "string"
          },
          "mission_id": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "used",
              "helpful",
              "rejected",
              "corrected",
              "excluded"
            ],
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "mission_id",
          "checkout"
        ],
        "type": "object"
      },
      "name": "coordination_record_synthesis_artifact"
    },
    {
      "description": "Replay a Coordinate proof packet chain by artifact_id, handoff_id, or proof_seq.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "handoff_id": {
            "type": "string"
          },
          "mission_id": {
            "type": "string"
          },
          "proof_seq": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "mission_id"
        ],
        "type": "object"
      },
      "name": "coordination_proof_trace"
    }
  ]
}
