    {
      "description": "After using retrieved context, record whether a memory item was useful, stale, corrected, or reinforced.",
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "default": "zaxy",
            "description": "Actor recording feedback",
            "type": "string"
          },
          "citation": {
            "description": "Eventloom citation for the retrieved context",
            "type": "string"
          },
          "entity_name": {
            "description": "Retrieved graph entity name",
            "type": "string"
          },
          "entity_type": {
            "description": "Retrieved graph entity type",
            "type": "string"
          },
          "feedback": {
            "description": "Retrieval outcome to record",
            "enum": [
              "used",
              "helpful",
              "irrelevant"
            ],
            "type": "string"
          },
          "importance": {
            "description": "Optional 0..1 reinforcement importance for positive feedback",
            "type": "number"
          },
          "query": {
            "description": "Query that returned the context",
            "type": "string"
          },
          "reason": {
            "description": "Short rationale for the feedback",
            "type": "string"
          },
          "score": {
            "description": "Original retrieval score",
            "type": "number"
          },
          "session_id": {
            "description": "Session ID for multi-agent sharding",
            "type": "string"
          },
          "source": {
            "default": "mcp",
            "description": "Retrieval source",
            "type": "string"
          }
        },
        "required": [
          "entity_name",
          "entity_type",
          "feedback"
        ],
        "type": "object"
      },
      "name": "memory_feedback"
    },
