              "type": "string"
            },
            "type": "array"
          },
          "reason": {
            "description": "Reason for status changes",
            "type": "string"
          },
          "session_id": {
            "description": "Session ID for multi-agent sharding",
            "type": "string"
          },
          "skill_id": {
            "description": "Stable skill identifier",
            "type": "string"
          },
          "success_score": {
            "description": "Outcome score from 0 to 1",
            "type": "number"
          },
          "summary": {
            "description": "Short skill summary",
            "type": "string"
          },
