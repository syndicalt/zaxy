          },
          "relation_type": {
            "type": "string",
            "description": "Optional causal relation taxonomy label"
          },
          "depth": {
            "type": "integer",
            "description": "Traversal depth",
            "default": 2,
            "minimum": 1
          },
          "session_id": {
            "type": "string",
            "description": "Session ID for scoped causal retrieval"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "memory_causal_predecessors",
