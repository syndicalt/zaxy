{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zaxy.dev/schemas/coordinationbench/runner-manifest.schema.json",
  "title": "CoordinationBench Runner Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "name",
    "display_name",
    "adapter_contract",
    "adapter_version",
    "install_command",
    "run_command",
    "source_url",
    "source_ref",
    "dataset_contract",
    "result_export_schema",
    "workload_fingerprint"
  ],
  "properties": {
    "name": {
      "enum": ["mem0", "agent_memory", "activegraph", "quarq", "hybi"]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "adapter_contract": {
      "const": "coordinationbench-v1"
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "install_command": {
      "type": "string",
      "minLength": 1
    },
    "run_command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "dataset_contract": {
      "type": "string",
      "minLength": 1
    },
    "result_export_schema": {
      "type": "string",
      "minLength": 1
    },
    "workload_fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "type": "boolean"
    }
  }
}
