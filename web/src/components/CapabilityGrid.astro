---
// The 5×2 capability grid — 10 tiles, each tagged with its initiative code
// and the event type it emits. The append-only log tile is highlighted as
// the substrate everything else rests on.
const tiles = [
  {
    tag: "I4",
    title: "Evolution gate",
    body: "Memory only changes through a governed-autonomy gate — auto, propose, or review.",
    event: "memory.evolution.gated",
  },
  {
    tag: "I1",
    title: "Outcome loop",
    body: "Agents report success or failure; lessons become cited, preventive rules.",
    event: "memory.outcome",
  },
  {
    tag: "I2",
    title: "Crystallization",
    body: "Idle-time consolidation merges near-duplicates without runtime cost.",
    event: "consolidation.run",
  },
  {
    tag: "I3",
    title: "Long-horizon recall",
    body: "Two-tier episodic / consolidated checkout for never-ending threads.",
    event: "checkout",
  },
  {
    tag: "core",
    title: "Replayable log",
    body: "An append-only, hash-chained Eventloom is the single source of truth.",
    event: "* (every event)",
    highlight: true,
  },
  {
    tag: "I7",
    title: "Fleet memory plane",
    body: "Governed cross-agent propagation with trust tiers and visibility scopes.",
    event: "fleet.rule.propagated",
  },
  {
    tag: "I5",
    title: "Editability",
    body: "Human edits and rollbacks are reversible, cited events — originals intact.",
    event: "memory.edit / rollback",
  },
  {
    tag: "I5b",
    title: "Verified forgetting",
    body: "Crypto-erasure destroys the payload key; the chain still verifies.",
    event: "memory.forget",
  },
  {
    tag: "I6",
    title: "Plugin API",
    body: "Extractors and skills extend the projection through an audited interface.",
    event: "inference.edge.generated",
  },
  {
    tag: "I8",
    title: "Proof",
    body: "LongMemEval-S re-baselined honestly: 0.898 (gpt-5, full 500) / 0.777 (gpt-4o, held-out) answer accuracy, full-haystack; the prior oracle-mode claims stay retracted.",
    event: "benchmark",
  },
];
---

<div class="grid">
  {
    tiles.map((t) => (
      <article class={`tile${t.highlight ? " tile--hl" : ""}`}>
        <span class="tile__tag mono">{t.tag}</span>
        <h3 class="tile__title">{t.title}</h3>
        <p class="tile__body">{t.body}</p>
        <span class="tile__event mono">{t.event}</span>
      </article>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .tile {
    background: var(--ink);
    padding: 22px 20px 18px;
    min-height: 178px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: background 0.15s ease;
  }
  .tile:hover {
    background: var(--ink-2);
  }
  .tile__tag {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    color: var(--faint);
    text-transform: uppercase;
  }
  .tile__title {
    font-size: 1.12rem;
    margin-bottom: 0.5em;
    padding-right: 2.4em;
  }
  .tile__body {
    font-size: 0.86rem;
    line-height: 1.5;
    color: var(--gray);
    margin: 0 0 auto;
  }
  .tile__event {
    margin-top: 14px;
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    color: var(--teal-dim);
  }
  .tile--hl {
    background: #0c161a;
    box-shadow: inset 0 0 0 1px var(--teal-dim);
  }
  .tile--hl .tile__event {
    color: var(--teal);
  }
  .tile--hl .tile__tag {
    color: var(--teal);
  }
  @media (max-width: 1040px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .tile {
      min-height: 0;
    }
  }
</style>
