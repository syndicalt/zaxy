---
const year = new Date().getFullYear();
const cols = [
  {
    title: "Product",
    links: [
      { href: "/#system", label: "Capabilities" },
      { href: "/#proof", label: "Proof" },
      { href: "/#evidence", label: "Evidence" },
      { href: "/install.html", label: "Install" },
    ],
  },
  {
    title: "Docs",
    links: [
      { href: "/docs/getting-started.html", label: "Getting started" },
      { href: "/docs/architecture.html", label: "Architecture" },
      { href: "/docs/mcp.html", label: "MCP tools" },
      { href: "/docs.html", label: "All docs" },
    ],
  },
  {
    title: "Project",
    links: [
      { href: "https://github.com/syndicalt/zaxy", label: "GitHub" },
      { href: "https://pypi.org/project/zaxy-memory/", label: "PyPI" },
      { href: "/docs/benchmarks.html", label: "Benchmarks" },
      { href: "/docs/external-validation.html", label: "External validation" },
    ],
  },
];
---

<footer class="ft">
  <hr class="rule" />
  <div class="wrap ft__grid">
    <div class="ft__brand">
      <span class="ft__mark" aria-hidden="true">Z</span>
      <p class="ft__tag">
        Event-sourced memory for agent fleets.<br />
        Append-only log → governed projection → cited checkout.
      </p>
      <p class="ft__cmd mono">uvx zaxy-memory@3.1.0</p>
    </div>
    {
      cols.map((c) => (
        <nav class="ft__col" aria-label={c.title}>
          <p class="ft__h">{c.title}</p>
          <ul>
            {c.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }
  </div>
  <div class="wrap ft__base">
    <span class="mono">Zaxy 3 — MIT</span>
    <span class="mono">© {year} · docs.zaxy.io</span>
  </div>
</footer>

<style>
  .ft {
    margin-top: clamp(40px, 8vw, 96px);
    color: var(--gray);
  }
  .ft__grid {
    display: grid;
    grid-template-columns: 1.4fr repeat(3, 1fr);
    gap: clamp(24px, 4vw, 56px);
    padding-block: clamp(40px, 6vw, 72px);
  }
  .ft__mark {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border: 1px solid var(--teal);
    color: var(--teal);
    font-family: var(--serif);
    border-radius: 2px;
    margin-bottom: 14px;
  }
  .ft__tag {
    font-size: 0.92rem;
    line-height: 1.5;
    max-width: 34ch;
  }
  .ft__cmd {
    font-size: 0.8rem;
    color: var(--teal-lt);
  }
  .ft__h {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 14px;
  }
  .ft__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 9px;
  }
  .ft__col a {
    font-size: 0.92rem;
    color: var(--gray);
  }
  .ft__col a:hover {
    color: var(--white);
  }
  .ft__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid var(--line);
    padding-block: 22px;
    font-size: 0.72rem;
    color: var(--faint);
  }
  @media (max-width: 760px) {
    .ft__grid {
      grid-template-columns: 1fr 1fr;
    }
    .ft__brand {
      grid-column: 1 / -1;
    }
  }
</style>
