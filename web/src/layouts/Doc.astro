---
import Base from "./Base.astro";
import type { NavGroup } from "../lib/nav";

interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props {
  title: string;
  description?: string;
  nav: NavGroup[];
  headings: Heading[];
  slug: string;
}
const { title, description, nav, headings, slug } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<Base title={`${title} — Zaxy 3 docs`} description={description}>
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
    integrity="sha384-nB0miv6/jRmo5UMMR1wu3Gz6NLsoTkbqJghGIsx//Rlm+ZU03BU6SQNC66uf4l5+"
    crossorigin="anonymous"
  />

  <div class="doc">
    <aside class="doc__side" aria-label="Docs navigation">
      <details class="doc__sidewrap" open>
        <summary class="doc__sidetoggle">Documentation</summary>
        <nav>
          {
            nav.map((g) => (
              <div class="navg">
                <p class="navg__h">{g.label}</p>
                <ul>
                  {g.items.map((it) => (
                    <li>
                      <a
                        href={it.href}
                        class="navl"
                        aria-current={it.slug === slug ? "page" : undefined}
                      >
                        {it.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </details>
    </aside>

    <article class="doc__main prose">
      <slot />
    </article>

    <aside class="doc__toc" aria-label="On this page">
      {
        toc.length > 0 && (
          <div class="toc">
            <p class="toc__h">On this page</p>
            <ul>
              {toc.map((h) => (
                <li class={h.depth === 3 ? "toc--sub" : ""}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>
</Base>

<style>
  .doc {
    display: grid;
    grid-template-columns: 232px minmax(0, 1fr) 200px;
    gap: clamp(24px, 4vw, 56px);
    padding-top: clamp(28px, 4vw, 48px);
    padding-bottom: clamp(48px, 8vw, 96px);
    align-items: start;
    padding-inline: var(--gutter);
  }
  .doc__side {
    position: sticky;
    top: 80px;
    max-height: calc(100vh - 96px);
    overflow-y: auto;
  }
  .doc__sidetoggle {
    display: none;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--faint);
    cursor: pointer;
    padding: 10px 0;
  }
  .navg {
    margin-bottom: 22px;
  }
  .navg__h {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 9px;
  }
  .navg ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
  }
  .navl {
    display: block;
    font-size: 0.86rem;
    line-height: 1.35;
    color: var(--gray);
    padding: 3px 0 3px 11px;
    border-left: 1px solid var(--line);
  }
  .navl:hover {
    color: var(--white);
    border-color: var(--line-strong);
  }
  .navl[aria-current="page"] {
    color: var(--teal-lt);
    border-color: var(--teal);
  }

  .doc__toc {
    position: sticky;
    top: 80px;
  }
  .toc__h {
    font-family: var(--mono);
    font-size: 0.64rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 10px;
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 7px;
  }
  .toc a {
    font-size: 0.8rem;
    color: var(--gray);
    line-height: 1.3;
  }
  .toc a:hover {
    color: var(--white);
  }
  .toc--sub {
    padding-left: 12px;
  }
  .toc--sub a {
    color: var(--faint);
    font-size: 0.76rem;
  }

  @media (max-width: 1080px) {
    .doc {
      grid-template-columns: 220px minmax(0, 1fr);
    }
    .doc__toc {
      display: none;
    }
  }
  @media (max-width: 820px) {
    .doc {
      grid-template-columns: 1fr;
    }
    .doc__side {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--line);
      margin-bottom: 20px;
    }
    .doc__sidetoggle {
      display: block;
    }
    .doc__sidewrap:not([open]) nav {
      display: none;
    }
  }
</style>

<style is:global>
  /* ---- rendered markdown (.prose) ---- */
  .prose {
    max-width: none;
    font-size: 1rem;
    line-height: 1.72;
    color: var(--text);
  }
  .prose > :first-child {
    margin-top: 0;
  }
  .prose h1 {
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.08;
    margin: 0 0 0.5em;
  }
  .prose h2 {
    font-size: 1.7rem;
    margin: 1.9em 0 0.6em;
    padding-top: 0.7em;
    border-top: 1px solid var(--line);
  }
  .prose h3 {
    font-size: 1.28rem;
    margin: 1.6em 0 0.5em;
  }
  .prose h4 {
    font-family: var(--sans);
    font-weight: 600;
    color: var(--white);
    font-size: 1.02rem;
    margin: 1.4em 0 0.4em;
  }
  .prose p,
  .prose li {
    color: var(--text);
  }
  .prose a {
    color: var(--teal-lt);
    border-bottom: 1px solid var(--line-strong);
    transition: border-color 0.15s ease;
  }
  .prose a:hover {
    color: var(--white);
    border-color: var(--teal);
  }
  .prose strong {
    color: var(--white);
  }
  .prose ul,
  .prose ol {
    padding-left: 1.3em;
    margin: 0 0 1.1em;
  }
  .prose li {
    margin: 0.35em 0;
  }
  .prose li::marker {
    color: var(--faint);
  }
  .prose blockquote {
    margin: 1.3em 0;
    padding: 0.2em 0 0.2em 1.1em;
    border-left: 2px solid var(--teal-dim);
    color: var(--gray);
    font-style: italic;
  }
  .prose hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 2em 0;
  }
  .prose code {
    font-family: var(--mono);
    font-size: 0.86em;
    color: var(--teal-lt);
    background: #0e1620;
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 0.1em 0.4em;
  }
  .prose pre {
    background: #0c141a !important;
    border: 1px solid var(--line-2);
    border-radius: var(--radius);
    padding: 16px 18px;
    overflow-x: auto;
    margin: 1.3em 0;
    font-size: 0.84rem;
    line-height: 1.6;
  }
  .prose pre code {
    background: none;
    border: 0;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  .prose img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: block;
    margin: 1.4em 0;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.4em 0;
    font-size: 0.9rem;
    display: block;
    overflow-x: auto;
  }
  .prose th,
  .prose td {
    text-align: left;
    padding: 9px 14px;
    border: 1px solid var(--line);
    vertical-align: top;
  }
  .prose th {
    font-family: var(--mono);
    font-size: 0.74rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--faint);
    background: var(--ink-2);
    font-weight: 500;
  }
  .prose :target {
    scroll-margin-top: 84px;
  }
</style>
