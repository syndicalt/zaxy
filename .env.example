# Zaxy environment configuration
# Copy this file to `.env` and customize, or run `./scripts/setup.sh` to generate one.

# ------------------------------------------------------------------
# Neo4j
# ------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-strong-password
# NEO4J_PASSWORD_FILE=/run/secrets/neo4j_password
NEO4J_DATABASE=neo4j
NEO4J_CA_CERT=
NEO4J_TRUST_ALL=false

# ------------------------------------------------------------------
# Eventloom
# ------------------------------------------------------------------
EVENTLOOM_PATH=.eventloom
EVENTLOOM_THREAD=default

# ------------------------------------------------------------------
# Pathlight (optional)
# ------------------------------------------------------------------
PATHLIGHT_URL=http://pathlight-collector:4100
PATHLIGHT_ENABLED=false
# PATHLIGHT_PROJECT_ID=your-project-id
# PATHLIGHT_ACCESS_TOKEN=your-token
# PATHLIGHT_ACCESS_TOKEN_FILE=/run/secrets/pathlight_access_token
TRACE_RAW_QUERIES=false

# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
ZAXY_ENV=development
SERVER_NAME=zaxy-memory
# MCP_ADMIN_TOKEN=your-admin-token
# MCP_ADMIN_TOKEN_FILE=/run/secrets/mcp_admin_token
# MCP_REMOTE_AUTH_TOKEN=your-remote-sse-token
# MCP_REMOTE_AUTH_TOKEN_FILE=/run/secrets/mcp_remote_auth_token
MCP_REMOTE_SESSION_HEADER=x-zaxy-session-id

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=console

# ------------------------------------------------------------------
# Query router
# ------------------------------------------------------------------
QUERY_DEFAULT_LIMIT=10

# ------------------------------------------------------------------
# Embeddings
# ------------------------------------------------------------------
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=hash
EMBEDDING_DIMENSION=1536
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_KEY_FILE=/run/secrets/openai_api_key
